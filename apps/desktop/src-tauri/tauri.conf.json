{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QIDIR",
  "version": "1.0.0",
  "identifier": "kz.qidir.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "QIDIR",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "QIDIR",
    "category": "Productivity",
    "copyright": "© 2026 QIDIR contributors. MIT License.",
    "shortDescription": "Локальный полнотекстовый поиск файлов (RU/KZ/EN)",
    "longDescription": "QIDIR — современный аналог классических программ локального полнотекстового поиска: мгновенный поиск по содержимому документов с индексированием и поддержкой русского, казахского и английского языков.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": true
      },
      "wix": {
        "language": ["ru-RU", "en-US"]
      }
    }
  },
  "plugins": {}
}
